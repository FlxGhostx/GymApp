{
  "name": "overload-tracker",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "postbuild:web": "node -e \"const fs=require('fs');fs.writeFileSync('dist/.nojekyll','');fs.copyFileSync('dist/index.html','dist/404.html')\"",
    "predeploy": "npm run build:web",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.71.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
